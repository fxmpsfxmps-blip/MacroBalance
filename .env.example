# La integración actual no necesita secretos de servidor.
# La configuración web pública de Firebase vive en firebase-init.js.
# Nunca agregues aquí credenciales de Firebase Admin ni llaves privadas.

# Shadow deployment integration: defaults remain OFF. Values below are examples only.
MB_SHADOW_CLIENT_ENABLED=false
MB_SHADOW_SERVER_ENABLED=false
MB_SHADOW_KILL_SWITCH=true
MB_SHADOW_SAMPLE_BPS=0
MB_SHADOW_AUTH_PROJECT_ID=macrobalance-502bb
MB_SHADOW_ALLOWED_ORIGIN=
MB_SHADOW_DATASTORE_PROJECT_ID=
MB_SHADOW_DATASTORE_PATH_PREFIX=shadow
MB_SHADOW_DATASTORE_URL=
MB_SHADOW_DATASTORE_TOKEN=
MB_SHADOW_PSEUDONYM_SECRET=
MB_SHADOW_HEALTH_TOKEN=
MB_SHADOW_ALERT_DESTINATION=
